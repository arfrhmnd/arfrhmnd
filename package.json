{
  "name": "phtn-ai-automation-framework",
  "version": "1.0.0",
  "description": "WebdriverIO automation framework for PHTN.ai website testing",
  "main": "index.js",
  "scripts": {
    "test": "wdio run wdio.conf.js",
    "test:critical": "wdio run wdio.conf.js --suite critical",
    "test:smoke": "wdio run wdio.conf.js --suite smoke",
    "test:regression": "wdio run wdio.conf.js --suite regression",
    "test:headless": "wdio run wdio.conf.js --headless",
    "test:safe": "./run-tests-safe.sh",
    "test:safe:critical": "./run-tests-safe.sh --suite critical",
    "test:safe:smoke": "./run-tests-safe.sh --suite smoke",
    "test:safe:regression": "./run-tests-safe.sh --suite regression",
    "test:safe:headless": "./run-tests-safe.sh --headless",
    "test:safe:report": "./run-tests-safe.sh --report",
    "report": "npx allure generate allure-results --clean -o allure-report && npx allure open allure-report",
    "report:generate": "npx allure generate allure-results --clean -o allure-report",
    "report:open": "npx allure open allure-report",
    "html": "open ./reports/html-reports/report.html",
    "report:html": "open ./reports/html-reports/report.html",
    "report:html:master": "open ./reports/html-reports/master-report.html",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "keywords": [
    "webdriverio",
    "automation",
    "testing",
    "phtn.ai"
  ],
  "author": "Automation Team",
  "license": "MIT",
  "devDependencies": {
    "@wdio/allure-reporter": "^8.16.0",
    "@wdio/cli": "^9.20.0",
    "@wdio/devtools-service": "^7.16.4",
    "@wdio/local-runner": "^9.20.0",
    "@wdio/mocha-framework": "^9.20.0",
    "@wdio/spec-reporter": "^8.16.0",
    "allure-commandline": "^2.34.1",
    "chai": "^4.3.7",
    "eslint": "^8.50.0",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-import": "^2.28.1",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-promise": "^6.1.1",
    "selenium-standalone": "^8.0.0",
    "wdio-html-nice-reporter": "^7.9.1"
  },
  "dependencies": {
    "dotenv": "^16.3.1"
  }
}
